{
    "$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
    "collections": [
        { "name": "store",    "path": "app/stores/sqlite" },
        { "name": "identity", "path": "app/platform/authz/anonymous" },
        { "name": "client",   "path": "app/platform/client/vanilla" },
        { "name": "theme",    "path": "app/platform/theme/full" }
    ],
    "enable_document_symbols": true,
    "enable_hover": true,
    "enable_snippets": true
}

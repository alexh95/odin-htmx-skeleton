bin/
vendor/htmx/htmx.min.js
vendor/htmx/ext/
vendor/hyperscript/_hyperscript.*
# tools/bundle's output, per profile: prepare writes it, build.sh embeds it.
build/
*.exe
*.pdb

# SQLite amalgamation: fetched + compiled by prepare.* into here (like htmx.min.js),
# pinned by version+SHA-256 in the script. Source and built lib are never committed.
vendor/sqlite/

# Runtime SQLite DB (only when DB_PATH points at a file; :memory: writes nothing).
data.db
data.db-wal
data.db-shm

# odin-http is vendored in-tree (vendor/odin-http, with its UPSTREAM.md), not ignored.

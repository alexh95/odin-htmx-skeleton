+// ---- writes answered later -------------------------------------------------
+//
+// A write goes to the store's writer task (services.*_later), which commits
+// concurrent writes together, and its handler returns without answering. The
+// continuation answers on this loop once the write has committed, from a Later
+// in the request's arena: it lives until the answer has been sent.
+
+Later :: struct {
+	req:    ^http.Request,
+	res:    ^http.Response,
+	start:  time.Tick, // the handler's start: front's own few µs before it are not in the log
+	id:     int,
+	detail: bool, // contacts_update: answer with the drawer
+	drawer: bool, // contacts_delete: the delete came from the drawer
+}
+
+@(private = "file")
+later :: proc(req: ^http.Request, res: ^http.Response) -> ^Later {
+	l := new(Later, context.temp_allocator)
+	l^ = {req = req, res = res, start = time.tick_now()}
+	return l
+}
+
+// front logs a request when its handler returns answered; a continuation logs
+// its own.
+@(private = "file")
+answered :: proc(l: ^Later) {
+	access_log(l.req, l.res, l.start)
+}

diff --git a/app/src/repository/writer.odin b/app/src/repository/writer.odin
new file mode 100644
index 0000000..2e014be
--- /dev/null
+++ b/app/src/repository/writer.odin
@@ -0,0 +1,274 @@
+package repository
+
+import "../models"
+import "../sqlite"
+
+import "base:runtime"
+import "core:log"
+import "core:nbio"
+import "core:strings"
+import "core:sync"
+import "core:thread"
+
+// ---- the writer task: request writes, committed in groups ----------------
+//
+// A handler's write is queued, not run. One thread takes every write waiting
+// (up to MAX_BATCH), runs them in one transaction, and hands each result back
+// to the event loop that queued it, one next_tick per loop per batch, where the
+// handler's continuation answers. Concurrent writes then share one commit,
+// which is where a WAL write spends its time (the frames, the wal-index, the
+// file locks), and no loop waits on the writer's lock. The answer still comes
+// after the commit, and the read-back still runs on the writer inside the
+// transaction, so a client sees what it would have seen from a lone write.
+//
+// There is no timer: the thread commits what is queued at once, so a lone
+// write waits only for the hop between threads, and the writes that arrive
+// while a batch commits form the next one.
+
+MAX_BATCH :: 100
+
+// A queued write's result, on the loop that queued it. The row is in that
+// request's temp arena, like any read's; a delete hands back none.
+Write_Done :: #type proc(user: rawptr, row: models.Contact, err: Error)
+
+Write_Kind :: enum u8 {
+	Create,
+	Update,
+	Cycle,
+	Delete,
+}
+
+@(private)
+Write :: struct {
+	next:  ^Write,
+	kind:  Write_Kind,
+	id:    int, // Update, Cycle, Delete
+	args:  models.Contact, // Create, Update; its strings on the heap
+	row:   models.Contact, // the read-back; its strings on the heap
+	err:   Error,
+	loop:  ^nbio.Event_Loop,
+	arena: runtime.Allocator, // the request's temp allocator
+	user:  rawptr,
+	done:  Write_Done,
+}
+
+@(private = "file") queue: struct {
+	lock:       sync.Mutex,
+	cond:       sync.Cond,
+	head, tail: ^Write,
+	sleeping:   bool, // the writer waits on cond: wake it
+	stopping:   bool,
+}
+@(private = "file") writer: ^thread.Thread
+@(private = "file") writer_logger: log.Logger
+
+// ---- the contract: contacts.odin's writes, queued -----------------------
+//
+// Each is the repo_* write of the same name; `done` runs later, on the caller's
+// event loop, once the transaction holding the write has committed. Called
+// from a handler on an event-loop thread.
+
+repo_create_later :: proc(name, email: string, role: models.Role, status: models.Status, score: int, notes: string, notify: bool, user: rawptr, done: Write_Done) {
+	enqueue(.Create, 0, {name = name, email = email, role = role, status = status, score = score, notes = notes, notify = notify}, user, done)
+}
+
+repo_update_later :: proc(id: int, name, email: string, role: models.Role, status: models.Status, score: int, user: rawptr, done: Write_Done) {
+	enqueue(.Update, id, {name = name, email = email, role = role, status = status, score = score}, user, done)
+}
+
+repo_cycle_status_later :: proc(id: int, user: rawptr, done: Write_Done) {
+	enqueue(.Cycle, id, {}, user, done)
+}
+
+repo_delete_later :: proc(id: int, user: rawptr, done: Write_Done) {
+	enqueue(.Delete, id, {}, user, done)
+}
+
+// ---- lifecycle (repo_open / repo_close) ----------------------------------
+
+@(private)
+writer_start :: proc() {
+	writer_logger = context.logger
+	queue.stopping = false
+	writer = thread.create(writer_main)
+	thread.start(writer)
+}
+
+// Called after the server loop returns, so nothing queues behind it; the writes
+// still queued run first.
+@(private)
+writer_stop :: proc() {
+	if writer == nil {
+		return
+	}
+	sync.mutex_lock(&queue.lock)
+	queue.stopping = true
+	sync.mutex_unlock(&queue.lock)
+	sync.cond_signal(&queue.cond)
+	thread.join(writer)
+	thread.destroy(writer)
+	writer = nil
+}
+
+// ---- internals -----------------------------------------------------------
+
+@(private = "file")
+enqueue :: proc(kind: Write_Kind, id: int, args: models.Contact, user: rawptr, done: Write_Done) {
+	heap := runtime.heap_allocator()
+	wr := new(Write, heap)
+	wr^ = {
+		kind  = kind,
+		id    = id,
+		args  = args,
+		loop  = nbio.current_thread_event_loop(),
+		arena = context.temp_allocator,
+		user  = user,
+		done  = done,
+	}
+	wr.args.name = strings.clone(args.name, heap)
+	wr.args.email = strings.clone(args.email, heap)
+	wr.args.notes = strings.clone(args.notes, heap)
+
+	sync.mutex_lock(&queue.lock)
+	if queue.tail == nil {
+		queue.head = wr
+	} else {
+		queue.tail.next = wr
+	}
+	queue.tail = wr
+	wake := queue.sleeping
+	queue.sleeping = false
+	sync.mutex_unlock(&queue.lock)
+	if wake {
+		sync.cond_signal(&queue.cond)
+	}
+}
+
+@(private = "file")
+writer_main :: proc(_: ^thread.Thread) {
+	context.logger = writer_logger
+	for {
+		sync.mutex_lock(&queue.lock)
+		for queue.head == nil && !queue.stopping {
+			queue.sleeping = true
+			sync.cond_wait(&queue.cond, &queue.lock)
+		}
+		batch := queue.head
+		if batch == nil {
+			// stopping, and nothing left
+			sync.mutex_unlock(&queue.lock)
+			return
+		}
+		last := batch
+		for n := 1; n < MAX_BATCH && last.next != nil; n += 1 {
+			last = last.next
+		}
+		queue.head = last.next
+		if queue.head == nil {
+			queue.tail = nil
+		}
+		last.next = nil
+		sync.mutex_unlock(&queue.lock)
+
+		commit_batch(batch)
+		reply(batch)
+	}
+}
+
+// Runs every write of the batch in one transaction. A write that fails on its
+// own (a constraint, a missing row) fails alone: SQLite undoes that one
+// statement and the transaction goes on. When the transaction itself is lost
+// (BEGIN or COMMIT fails, or an error rolls it back), every write in it fails.
+@(private)
+commit_batch :: proc(batch: ^Write) {
+	// The read-backs are handed to other threads, so they go on the heap.
+	context.temp_allocator = runtime.heap_allocator()
+	sync.guard(&wlock)
+	ok := sqlite.exec(db, "BEGIN IMMEDIATE;", nil, nil, nil) == sqlite.OK
+	for wr := batch; ok && wr != nil; wr = wr.next {
+		wr.row, wr.err = apply(wr)
+		ok = sqlite.get_autocommit(db) == 0 // still inside the transaction
+	}
+	if ok && sqlite.exec(db, "COMMIT;", nil, nil, nil) == sqlite.OK {
+		return
+	}
+	log.errorf("store: a batch of writes failed: %s", sqlite.errmsg(db))
+	if sqlite.get_autocommit(db) == 0 {
+		sqlite.exec(db, "ROLLBACK;", nil, nil, nil)
+	}
+	for wr := batch; wr != nil; wr = wr.next {
+		wr.err = .Failed
+	}
+}
+
+@(private = "file")
+apply :: proc(wr: ^Write) -> (models.Contact, Error) {
+	a := wr.args
+	switch wr.kind {
+	case .Create:
+		return create_get_unlocked(a.name, a.email, a.role, a.status, a.score, a.notes, a.notify)
+	case .Update:
+		return update_unlocked(wr.id, a.name, a.email, a.role, a.status, a.score)
+	case .Cycle:
+		return cycle_unlocked(wr.id)
+	case .Delete:
+		return {}, delete_unlocked(wr.id)
+	}
+	return {}, .Failed
+}
+
+// Each loop gets its writes back in one next_tick, in the order they queued.
+@(private = "file")
+reply :: proc(batch: ^Write) {
+	link :: proc(head, tail: ^^Write, wr: ^Write) {
+		if tail^ == nil {
+			head^ = wr
+		} else {
+			tail^.next = wr
+		}
+		tail^ = wr
+	}
+	rest := batch
+	for rest != nil {
+		loop := rest.loop
+		mine, mine_tail, others, others_tail: ^Write
+		for wr := rest; wr != nil; {
+			next := wr.next
+			wr.next = nil
+			if wr.loop == loop {
+				link(&mine, &mine_tail, wr)
+			} else {
+				link(&others, &others_tail, wr)
+			}
+			wr = next
+		}
+		nbio.next_tick_poly(mine, deliver, l = loop)
+		rest = others
+	}
+}
+
+// On the loop that queued the writes: each continuation runs with its request's
+// temp allocator, and gets its row cloned into it.
+@(private = "file")
+deliver :: proc(_: ^nbio.Operation, list: ^Write) {
+	for wr := list; wr != nil; {
+		next := wr.next
+		context.temp_allocator = wr.arena
+		row := wr.row
+		row.name = strings.clone(row.name, wr.arena)
+		row.email = strings.clone(row.email, wr.arena)
+		row.notes = strings.clone(row.notes, wr.arena)
+		wr.done(wr.user, row, wr.err)
+		free_write(wr)
+		wr = next
+	}
+}
+
+@(private)
+free_write :: proc(wr: ^Write) {
+	heap := runtime.heap_allocator()
+	for s in ([]string{wr.args.name, wr.args.email, wr.args.notes, wr.row.name, wr.row.email, wr.row.notes}) {
+		delete(s, heap)
+	}
+	free(wr, heap)
+}

+// A batch of the writer task commits its writes together, and each gets the
+// answer it would have got alone: a failing one fails alone.
+@(test)
+a_batch_answers_each_write_as_if_alone :: proc(t: ^testing.T) {
+	sync.guard(&serial)
+	repo_open(":memory:")
+	defer repo_close()
+	repo_seed()
+	// A statement that fails inside the transaction: SQLite undoes it, not the batch.
+	exec("CREATE TEMP TRIGGER refuse BEFORE INSERT ON contacts WHEN NEW.name = 'refused' BEGIN SELECT RAISE(ABORT, 'refused'); END;")
+
+	writes := [?]Write {
+		{kind = .Create, args = {name = "Batch New", email = "batch.new@example.dev", role = .Support, status = .Invited, score = 50}},
+		{kind = .Update, id = 1, args = {name = "Batch Edit", email = "batch.edit@example.dev", role = .Manager, status = .Active, score = 77}},
+		{kind = .Cycle, id = 2},
+		{kind = .Delete, id = 3},
+		{kind = .Create, args = {name = "refused", email = "refused@example.dev"}},
+		{kind = .Update, id = 999_999, args = {name = "Nobody", email = "nobody@example.dev"}},
+		{kind = .Delete, id = 999_999},
+	}
+	before, _ := repo_get(2)
+	for i in 0 ..< len(writes) - 1 {
+		writes[i].next = &writes[i + 1]
+	}
+	context.logger = log.nil_logger() // the refused insert logs its error
+	commit_batch(&writes[0])
+	defer for &wr in writes {
+		wr.args = {}
+		heap_free_row(&wr)
+	}
+
+	testing.expect_value(t, writes[0].err, Error.None)
+	testing.expect(t, writes[0].row.id > 20 && writes[0].row.name == "Batch New", "the create reads back its row")
+	testing.expect_value(t, writes[1].err, Error.None)
+	testing.expect(t, writes[1].row.name == "Batch Edit" && writes[1].row.score == 77 && writes[1].row.role == .Manager, "the update reads back its row")
+	testing.expect_value(t, writes[2].err, Error.None)
+	testing.expect_value(t, writes[2].row.status, models.Status((int(before.status) + 1) % len(models.Status)))
+	testing.expect_value(t, writes[3].err, Error.None)
+	testing.expect_value(t, writes[4].err, Error.Constraint)
+	testing.expect_value(t, writes[5].err, Error.Not_Found)
+	testing.expect_value(t, writes[6].err, Error.Not_Found)
+
+	// Committed: a reader sees them.
+	got, _ := repo_get(writes[0].row.id)
+	testing.expect_value(t, got.name, "Batch New")
+	_, gone := repo_get(3)
+	testing.expect_value(t, gone, Error.Not_Found)
+}
+
+@(private = "file")
+heap_free_row :: proc(wr: ^Write) {
+	for s in ([]string{wr.row.name, wr.row.email, wr.row.notes}) {
+		delete(s, runtime.heap_allocator())
+	}
+}

 }
 
+// ---- contacts: writes answered later --------------------------------------
+//
+// The same four writes, validated the same way, but queued for the store's
+// writer task (repository/writer.odin), which commits concurrent writes
+// together: `done` runs later on this event loop, after the commit, with the
+// stored row. Refused input still comes back at once, and nothing is queued.
+
+Write_Done :: repository.Write_Done
+
+create_contact_later :: proc(name, email: string, role: models.Role, status: models.Status, score: int, notes: string, notify: bool, user: rawptr, done: Write_Done) -> []Field_Error {
+	if errs := validate_contact(name, email, notes); len(errs) > 0 {
+		return errs
+	}
+	repository.repo_create_later(strings.trim_space(name), strings.trim_space(email), role, status, clamp(score, 0, 100), strings.trim_space(notes), notify, user, done)
+	return nil
+}
+
+// Rejected input comes back with the stored contact, unchanged, as from
+// update_contact; then `done` never runs.
+update_contact_later :: proc(id: int, name, email: string, role: models.Role, status: models.Status, score: int, user: rawptr, done: Write_Done) -> (c: models.Contact, errs: []Field_Error, err: Store_Error) {
+	if errs = validate_contact(name, email); len(errs) > 0 {
+		c, err = repository.repo_get(id)
+		return
+	}
+	repository.repo_update_later(id, strings.trim_space(name), strings.trim_space(email), role, status, clamp(score, 0, 100), user, done)
+	return
+}
+
+cycle_status_later :: proc(id: int, user: rawptr, done: Write_Done) {
+	repository.repo_cycle_status_later(id, user, done)
+}
+
+delete_contact_later :: proc(id: int, user: rawptr, done: Write_Done) {
+	repository.repo_delete_later(id, user, done)
+}

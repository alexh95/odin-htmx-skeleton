From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 02:29:43 +0200
Subject: [PATCH] perf(repository): a sort index per list sort key

0004_sort_indexes.sql adds (name, id), (email, id), (score, id) and the
role and status label-rank CASE expressions with id, so a page of
/contacts is read in order from its index instead of sorting every row
that passed the filter (PLAN 11.1; D16). The indexes cost every insert
and update that touches the columns.

A test runs EXPLAIN QUERY PLAN on all ten page statements and fails if
one sorts in a temp B-tree, so the CASE in the migration and order_by in
contacts.odin can't drift apart silently.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/repository/db_test.odin               | 26 +++++++++++++++++++
 .../migrations/0004_sort_indexes.sql          | 11 ++++++++
 app/src/repository/repo.odin                  |  3 ++-
 3 files changed, 39 insertions(+), 1 deletion(-)
 create mode 100644 app/src/repository/migrations/0004_sort_indexes.sql

diff --git a/app/src/repository/db_test.odin b/app/src/repository/db_test.odin
index 013d394..f0cce76 100644
--- a/app/src/repository/db_test.odin
+++ b/app/src/repository/db_test.odin
@@ -197,3 +197,29 @@ a_bound_limit_never_reprepares :: proc(t: ^testing.T) {
 		testing.expectf(t, reprepares == 0, "%v: %d re-prepares in 1000 pages", mode, reprepares)
 	}
 }
+
+// Every page statement reads its rows in order from its sort index
+// (0004_sort_indexes.sql) instead of sorting them: role's and status's indexes
+// are on the CASE expression order_by builds, so the two must agree.
+@(test)
+every_page_reads_its_sort_index :: proc(t: ^testing.T) {
+	sync.guard(&serial)
+	repo_open(":memory:")
+	defer repo_close()
+	r := read_begin()
+	defer read_end(r)
+	for by_dir, key in r.contacts.q_page {
+		for st, desc in by_dir {
+			plan: sqlite.Stmt
+			prep_on(r.db, csql(fmt.tprintf("EXPLAIN QUERY PLAN %s", sqlite.sql(st))), &plan)
+			defer sqlite.finalize(plan)
+			steps := make([dynamic]string, context.temp_allocator)
+			err: Error
+			for next_row(plan, &err) {
+				append(&steps, clone_col(plan, 3))
+			}
+			text := strings.join(steps[:], "; ", context.temp_allocator)
+			testing.expectf(t, strings.contains(text, "idx_contacts_by_") && !strings.contains(text, "TEMP B-TREE"), "%v desc=%d: %s", key, desc, text)
+		}
+	}
+}
diff --git a/app/src/repository/migrations/0004_sort_indexes.sql b/app/src/repository/migrations/0004_sort_indexes.sql
new file mode 100644
index 0000000..d366b57
--- /dev/null
+++ b/app/src/repository/migrations/0004_sort_indexes.sql
@@ -0,0 +1,11 @@
+-- One index per sort key of the contacts table (order_by in contacts.odin),
+-- each ending in id, the tie-break every page sorts by: a page is then read in
+-- order from its index instead of sorting every row that passed the filter.
+-- Role and status sort by their label's A-to-Z rank, so theirs are on the same
+-- CASE expression order_by builds from the label tables; a test in db_test.odin
+-- fails if a page statement stops using its index.
+CREATE INDEX IF NOT EXISTS idx_contacts_by_name   ON contacts(name, id);
+CREATE INDEX IF NOT EXISTS idx_contacts_by_email  ON contacts(email, id);
+CREATE INDEX IF NOT EXISTS idx_contacts_by_score  ON contacts(score, id);
+CREATE INDEX IF NOT EXISTS idx_contacts_by_role   ON contacts((CASE role WHEN 0 THEN 1 WHEN 1 THEN 0 WHEN 2 THEN 2 WHEN 3 THEN 3 WHEN 4 THEN 4 END), id);
+CREATE INDEX IF NOT EXISTS idx_contacts_by_status ON contacts((CASE status WHEN 0 THEN 0 WHEN 1 THEN 2 WHEN 2 THEN 1 END), id);
diff --git a/app/src/repository/repo.odin b/app/src/repository/repo.odin
index 743e337..31a40bf 100644
--- a/app/src/repository/repo.odin
+++ b/app/src/repository/repo.odin
@@ -13,12 +13,13 @@ import "core:sync"
 // repository knows SQL.
 
 // The schema, in order (see migrate in db.odin). #load'd so it rides inside
-// the binary. To grow it, add 0004_*.sql and list it here; never edit a file
+// the binary. To grow it, add 0005_*.sql and list it here; never edit a file
 // that has shipped, since every database records each one's hash.
 @(private = "file") MIGRATIONS := [?]Migration {
 	{"0001_init.sql", #load("migrations/0001_init.sql", string)},
 	{"0002_events.sql", #load("migrations/0002_events.sql", string)},
 	{"0003_contact_notes.sql", #load("migrations/0003_contact_notes.sql", string)},
+	{"0004_sort_indexes.sql", #load("migrations/0004_sort_indexes.sql", string)},
 }
 
 // One connection and every table's read statements on it: each loop's reader

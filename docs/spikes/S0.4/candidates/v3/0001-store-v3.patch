+	}
+	open_path = strings.clone_to_cstring(open)
+	generation += 1
+	readers = make([dynamic]^Conn, runtime.heap_allocator())
+	if sqlite.open_v2(open_path, &db, sqlite.OPEN_READWRITE | sqlite.OPEN_CREATE, nil) != sqlite.OK {

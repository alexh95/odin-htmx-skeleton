+@(private = "file") temp_path: string // Ephemeral: the file to delete on close
+@(private = "file") generation: int // bumped per db_open, so a thread drops a reader from an earlier one
+@(private = "file") readers: [dynamic]^Conn // every reader opened, closed by db_close

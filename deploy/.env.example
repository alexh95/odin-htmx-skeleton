# The image tag of each service (PLAN §20.2): a release's vX.Y.Z, never `latest`.
# promote.ps1 writes the real .env beside compose.yaml on the host and changes one line
# per promote; this file is the shape it writes.
IMAGE_PREFIX=ghcr.io/alexh95/odin-htmx-starter
TAG_MINIMAL=v2.2.0
TAG_STREAMS=v2.2.0
TAG_SKELETON=v2.2.0
TAG_LAB=v2.2.0
